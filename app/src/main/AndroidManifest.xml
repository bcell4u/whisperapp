<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Qualcomm/vendor OpenCL runtime used by the production Parakeet-family worker. -->

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/lab_data_extraction_rules"
        android:label="Qwen GGUF Lab"
        android:icon="@drawable/ic_qwen_gguf_lab"
        android:roundIcon="@drawable/ic_qwen_gguf_lab"
        android:theme="@style/Theme.WhisperRecorder"
        android:usesCleartextTraffic="false">
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />
        <!-- FastRPC is device supplied. QNN/HTP uses it to reach the Hexagon DSP/NPU. -->
        <uses-native-library
            android:name="libcdsprpc.so"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".audio.RecordingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name=".speaker.SpeakerDiarizationService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".transcribe.TranscriptionService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".models.ModelDownloadService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".gpu.ParakeetOpenClWorkerService"
            android:exported="false"
            android:process=":opencl"
            android:stopWithTask="false" />
        <service
            android:name=".npu.NpuRuntimeWorkerService"
            android:exported="false"
            android:process=":npu"
            android:stopWithTask="true" />
        <service
            android:name=".qwen.Qwen3HybridWorkerService"
            android:exported="false"
            android:process=":qwenlab"
            android:stopWithTask="true" />
        <activity
            android:name=".qwen.QwenGgufLabActivity"
            android:exported="true"
            android:label="Qwen GGUF Lab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
